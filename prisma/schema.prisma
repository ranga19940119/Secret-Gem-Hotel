// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Floor {
  id    String @id @default(cuid())
  name  String @unique
  level Int    @default(1)
  rooms Room[]
}

model Room {
  id            String        @id @default(cuid())
  roomNumber    String        @unique
  type          String        // e.g., "Standard", "Deluxe", "Suite"
  status        String        @default("AVAILABLE") // AVAILABLE, OCCUPIED, CLEANING_REQUIRED, UNDER_MAINTENANCE
  pricePerNight Float
  description   String?
  features      String?       // JSON string or comma separated
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  floorId       String?
  floor         Floor?        @relation(fields: [floorId], references: [id])
  reservations  Reservation[]
}

model Reservation {
  id            String   @id @default(cuid())
  guestName     String
  guestEmail    String?
  guestPhone    String?
  checkIn       DateTime
  checkOut      DateTime
  status        String   @default("PENDING") // PENDING, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED
  source        String   @default("MANUAL") // MANUAL, WEBSITE, BOOKING.COM, AGODA
  totalAmount   Float
  paidAmount    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roomId        String
  room          Room     @relation(fields: [roomId], references: [id])
}

model Content {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
